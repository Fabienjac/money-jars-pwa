GSCRIPT_URL=https://script.google.com/macros/s/TON_DEPLOIEMENT/exec
API_KEY=MoneyApp_2025_fabien_secret

# ── Backend Supabase (version commerciale) ────────────────────────────────────
VITE_SUPABASE_URL=https://TON_PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=ta_cle_anon_publique

# Clé service-role (UNIQUEMENT dans les Netlify env vars, jamais dans le front)
SUPABASE_URL=https://TON_PROJET.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ta_cle_service_role_secrete

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...   # Price ID Stripe pour 7,90€/mois
STRIPE_PRICE_YEARLY=price_...    # Price ID Stripe pour 69€/an

# ── IA Gemini ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=ta_cle_gemini

# Notification email à chaque suggestion reçue (netlify/functions/notifyFeedback.js)
FEEDBACK_WEBHOOK_SECRET=une_longue_chaine_aleatoire   # la même dans l'en-tête x-webhook-secret du webhook Supabase
RESEND_API_KEY=re_...
FEEDBACK_NOTIFY_TO=ton.adresse@exemple.com            # = l'adresse du compte Resend tant qu'aucun domaine n'est vérifié

# Notifications push d'alerte des jarres (netlify/functions/pushJarAlerts.js)
# Générer la paire : npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=clé_publique_vapid          # exposée au front (build) ; = VAPID_PUBLIC_KEY
VAPID_PUBLIC_KEY=clé_publique_vapid
VAPID_PRIVATE_KEY=clé_privée_vapid                # secrète, uniquement dans les variables Netlify
VAPID_SUBJECT=mailto:ton.adresse@exemple.com
